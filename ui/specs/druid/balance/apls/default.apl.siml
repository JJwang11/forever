siml 1
spec balance_druid

prepull:
  -1.5s cast wrath if number_targets < 4

priority:
  autocast_other_cooldowns
  cast innervate if current_mana_percent < 10%
  cast moonfire if not dot(moonfire).is_active
  cast insect_swarm if not dot(insect_swarm).is_active
  cast hurricane if number_targets >= 4
  cast starfire_rank6 if aura(eclipse).is_active
  cast wrath
